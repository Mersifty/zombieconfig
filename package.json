{
  "name": "zombieconfig",
  "version": "2.0.0",
  "description": "Zero-config multi-language Zombie Env & Ghost Variable Hunter for developers and CI/CD",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://github.com/Mersifty/zombieconfig#readme",
  "bugs": {
    "url": "https://github.com/Mersifty/zombieconfig/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mersifty/zombieconfig.git"
  },
  "bin": {
    "zombieconfig": "./bin/ghostconfig.js",
    "zombie": "./bin/ghostconfig.js",
    "ghostconfig": "./bin/ghostconfig.js",
    "ghost": "./bin/ghostconfig.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "scan": "node ./bin/ghostconfig.js scan",
    "doctor": "node ./bin/ghostconfig.js doctor",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "env",
    "environment-variables",
    "ghost-variables",
    "zombie-env",
    "developer-tools",
    "cli",
    "tui",
    "audit",
    "security",
    "dotenv",
    "diff",
    "doctor",
    "zod-generator",
    "type-safety",
    "secret-scanner",
    "devops"
  ],
  "author": "Mersifty",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
